APP_ENV=staging
APP_NAME=SEO Monitor Staging
API_KEY=replace-with-a-unique-random-staging-key
DATABASE_URL=postgresql+psycopg://seo_staging:replace-with-url-encoded-password@postgres:5432/seo_staging
API_DATABASE_URL=postgresql+psycopg://seo_api:replace-with-unique-api-password@postgres:5432/seo_staging
CRAWLER_DATABASE_URL=postgresql+psycopg://seo_crawler:replace-with-unique-crawler-password@postgres:5432/seo_staging
INTEGRATION_DATABASE_URL=postgresql+psycopg://seo_integration:replace-with-unique-integration-password@postgres:5432/seo_staging
EXPORT_DATABASE_URL=postgresql+psycopg://seo_export:replace-with-unique-export-password@postgres:5432/seo_staging
SCHEDULER_DATABASE_URL=postgresql+psycopg://seo_scheduler:replace-with-unique-scheduler-password@postgres:5432/seo_staging
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
USER_AGENT=SEO-Monitor-Staging-Bot/0.1
POSTGRES_DB=seo_staging
POSTGRES_USER=seo_staging
POSTGRES_PASSWORD=replace-with-a-unique-staging-password
DB_API_PASSWORD=replace-with-unique-api-password
DB_CRAWLER_PASSWORD=replace-with-unique-crawler-password
DB_INTEGRATION_PASSWORD=replace-with-unique-integration-password
DB_EXPORT_PASSWORD=replace-with-unique-export-password
DB_SCHEDULER_PASSWORD=replace-with-unique-scheduler-password
STAGING_API_PORT=18000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
BING_CLIENT_ID=
BING_CLIENT_SECRET=
BING_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=
INITIAL_SUPERUSER_EMAIL=
INITIAL_SUPERUSER_PASSWORD=
RENDERING_ENABLED=false
RENDER_ARTIFACT_DIR=/app/render-artifacts
RENDER_ARTIFACT_RETENTION_DAYS=90
PAGESPEED_ENABLED=false
PAGESPEED_API_KEY=
