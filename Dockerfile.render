FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS axe-core

WORKDIR /opt/axe
RUN npm pack axe-core@4.12.1 \
    && tar -xzf axe-core-4.12.1.tgz package/axe.min.js package/LICENSE \
    && mv package/axe.min.js package/LICENSE ./ \
    && rm -rf package axe-core-4.12.1.tgz

FROM mcr.microsoft.com/playwright/python:v1.62.0-noble@sha256:aa81288e738725378becba5b3e06cb0f3a7f012a610e87e8d767a090ea3f740d

# Apply current distribution security fixes; CI scans the resulting image.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get purge -y gstreamer1.0-plugins-bad libgstreamer-plugins-bad1.0-0 \
    && rm -rf /var/lib/apt/lists/* /ms-playwright/firefox-* /ms-playwright/webkit-*

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.lock requirements-render.lock ./
# This disposable image intentionally manages its global Python environment.
# OS upgrades restore the upstream EXTERNALLY-MANAGED marker.
RUN pip install --break-system-packages --no-cache-dir --require-hashes \
    -r requirements.lock -r requirements-render.lock \
    && python -m pip uninstall --break-system-packages -y pip
COPY --from=axe-core /opt/axe/axe.min.js /opt/axe/axe.min.js
COPY --from=axe-core /opt/axe/LICENSE /opt/axe/LICENSE
COPY --chown=pwuser:pwuser . .

USER pwuser
CMD ["python", "-m", "app.worker"]
