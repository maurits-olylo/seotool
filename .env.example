APP_ENV=development
SERVICE_ROLE=api
APP_NAME=SEO Monitor API
# Alleen voor lokale technische tests; wordt in productie altijd geweigerd.
API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seo.example.com/api/v1/integrations/google/callback
BING_CLIENT_ID=
BING_CLIENT_SECRET=
BING_REDIRECT_URI=https://seo.example.com/api/v1/integrations/bing/callback
TOKEN_ENCRYPTION_KEY=
INITIAL_SUPERUSER_EMAIL=
INITIAL_SUPERUSER_PASSWORD=
DATABASE_URL=postgresql+psycopg://seo:replace-with-long-random-password@postgres:5432/seo
API_DATABASE_URL=postgresql+psycopg://seo_api:replace-with-unique-api-password@postgres:5432/seo
CRAWLER_DATABASE_URL=postgresql+psycopg://seo_crawler:replace-with-unique-crawler-password@postgres:5432/seo
INTEGRATION_DATABASE_URL=postgresql+psycopg://seo_integration:replace-with-unique-integration-password@postgres:5432/seo
EXPORT_DATABASE_URL=postgresql+psycopg://seo_export:replace-with-unique-export-password@postgres:5432/seo
SCHEDULER_DATABASE_URL=postgresql+psycopg://seo_scheduler:replace-with-unique-scheduler-password@postgres:5432/seo
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
USER_AGENT=SEO-Monitor-Bot/0.1
RENDERING_ENABLED=false
RENDER_ARTIFACT_DIR=/app/render-artifacts
RENDER_ARTIFACT_RETENTION_DAYS=90
PAGESPEED_ENABLED=false
PAGESPEED_API_KEY=
# Blijft uit tot een afzonderlijk goedgekeurde betaalde validatieronde.
DATAFORSEO_ENABLED=false
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
EXTERNAL_SERP_ESTIMATED_COST_MICROS=0
EXTERNAL_AI_CITATIONS_ESTIMATED_COST_MICROS=0
MFA_ENFORCEMENT_ENABLED=false
API_PORT=8000
POSTGRES_DB=seo
POSTGRES_USER=seo
POSTGRES_PASSWORD=replace-with-long-random-password
DB_API_PASSWORD=replace-with-unique-api-password
DB_CRAWLER_PASSWORD=replace-with-unique-crawler-password
DB_INTEGRATION_PASSWORD=replace-with-unique-integration-password
DB_EXPORT_PASSWORD=replace-with-unique-export-password
DB_SCHEDULER_PASSWORD=replace-with-unique-scheduler-password
BACKUP_RETENTION_DAYS=30
BACKUP_KEY_FILE=/secure/path/seo-monitor-backup.key
BACKUP_MAX_AGE_HOURS=30
